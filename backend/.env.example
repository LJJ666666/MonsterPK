# SQLite 数据库文件路径（相对 prisma/ 目录）
DATABASE_URL="file:./dev.db"

# JWT 签名密钥 —— 生产环境必须换成随机长字符串
JWT_SECRET="change-me-in-prod-please-use-a-long-random-string"

# JWT 过期时间（fastify/jwt 的 expiresIn 语法：30d / 12h / 3600s 等）
JWT_TTL="30d"

# 后端监听端口
PORT=3001

# 允许跨域请求的前端地址（开发期前端跑在 5173）
CORS_ORIGIN="http://localhost:5173"

# 管理员账号白名单（逗号分隔，大小写不敏感）。命中的账号才能看到/使用测试菜单，
# 且异常数值（满属性、高等级、满金币等改档特征）不会被风控拦截封号。
# 也可以不改这里，用 `npm run admin -- grant <用户名>` 直接写库授权（推荐）。
# ⚠️ 这是服务端唯一授权来源，客户端无法伪造；留空表示仅数据库 role=admin 的账号是管理员。
ADMIN_USERNAMES=""
