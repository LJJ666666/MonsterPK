// MonsterPK 后端数据模型
// Postgres + Prisma（P5-1 W1 起，2026-11-12）。
// ⚠️ 原注释「迁移到 Postgres 只需把 provider 改成 postgresql」是错的：11 条旧迁移全是
// SQLite 方言（AUTOINCREMENT / DROP COLUMN / DATETIME），migration_lock.toml 也锁着
// sqlite，直接改 provider 会让 migrate deploy 全链失败。正确做法是归档旧链 + 重置 lock
// + 用一条 PG 基线 init 重建，见 .trae/documents/P5-1_F10_迁移实施设计定稿与工单_2026-11-11.md §1#1/#2。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 账号表：用户名唯一，密码存 bcrypt 哈希；角色与封号状态用于服务端风控
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  // 角色：player=普通玩家 / admin=管理员（测试菜单可用，异常数值放行）
  // 授权来源还有 .env 的 ADMIN_USERNAMES 白名单，两者取并集；判定在 lib/account.ts
  role      String   @default("player")
  // 封号时间，非空即视为已封号；认证守卫会拒绝该账号的所有后续请求
  bannedAt  DateTime?
  // 封号中文原因（展示给客户端弹窗）
  banReason String?
  // P4-1a 登录代次（顶号）：每次注册/登录 +1 并写进 JWT 的 sv。
  // 认证守卫比对 sv，旧设备 token 立刻失效，避免「刷新页面又把新设备顶掉」的死循环。
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  saves     Save[]
  bans      BanRecord[]
}

// 封号审计表：每次封号留痕，便于排查误封与执行解封；不存完整存档，避免表膨胀
model BanRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 触发封号的校验码列表，JSON 文本
  codes     String
  // 中文原因
  reason    String
  // 存档摘要指标，JSON 文本（money/maxLevel/...），不含完整存档
  stats     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// 存档表：F17 起**一个账号只有一档**（userId 唯一），data 为完整存档 JSON 文本。
model Save {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data          String
  // 存档内部 schema 版本（取自 data 解析后的 version 字段），用于识别脏档/版本错配
  schemaVersion String   @default("unknown")
  // 最近一次写入的客户端标识（每设备唯一），用于冲突判断（多端并发编辑时）
  clientId      String?
  // P1-2 服务端权威摘要（JSON 文本）：expected 资源摘要 + 挂机会话的服务端时钟 + revision。
  // 客户端整包 PUT 时用它做单调比对，自造的资源增量一律拒绝；裁决接口执行后同步更新。
  authority     String?
  // P5-1 W1 提列：CAS 基线原先藏在 authority JSON 的 revision 字段里，无独立列，
  // 导致规范 §21.3 的 `UPDATE ... WHERE revision = ?` 无法落地。本工单只建列 +
  // 一次性回填（不重编号、不 +1）；W2 才把它收敛为唯一 +1 源并改写入逻辑。
  revision      Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// 意图幂等表（P1-2）：每个意图带一次性 nonce，服务端用唯一索引防重放（重复领挂机收益等）。
// 不建 User 关联，避免级联删除干扰；按 userId 定期清理即可。
model IntentLog {
  id        Int      @id @default(autoincrement())
  userId    String
  nonce     String
  // 意图类型：idle_start / idle_claim / idle_cancel / capture / battle_reward / shop_buy / ...
  type      String
  createdAt DateTime @default(now())

  @@unique([userId, nonce])
  @@index([userId, createdAt])
}

// Boss 伤害事件（P4-2c）：**append-only**，一行 = 一次有效讨伐的结算结果。
// - 伤害值只来自服务端战斗态（`BattleState.damageDealt`），客户端上报一律不用；
// - `battleId` 唯一索引保证「同一场战斗重复结算 / 重复上报不叠加」；
// - 每日次数真值 = 本表该用户当日该 Boss 的行数（内存只记在途 hold，重启不重置次数）；
// - 不建 User 关联：封号清理不删历史伤害记录，查询时再按 User 过滤封号/管理员。
model BossDamageEvent {
  id        String   @id @default(cuid())
  userId    String
  bossId    String
  // 周期键：固定 UTC+8 自然日 YYYY-MM-DD；周期结算规则待台账 F01 细化
  periodKey String
  damage    Int
  // 结算结果：enemy_fainted / player_fainted（逃跑不写事件）
  result    String
  battleId  String   @unique
  createdAt DateTime @default(now())

  @@index([bossId, periodKey, damage])
  @@index([userId, bossId, periodKey])
}

// F01 榜单周期快照：一行 = 一张榜在某个**已结束**周期的最终名次。
// 唯一键保证结算幂等可重跑；entries 存完整榜单 JSON 文本，历史榜只读回放。
// 不建 User 关联：快照是匿名化后的只读视图，封号清理不影响历史归档。
model RankPeriodSnapshot {
  id        Int      @id @default(autoincrement())
  periodKey String
  boardKey  String
  entries   String
  eligible  Int      @default(0)
  skipped   Int      @default(0)
  settledAt DateTime @default(now())

  @@unique([periodKey, boardKey])
  @@index([periodKey])
}

// F02 榜单奖励发放记录：唯一键防重复领取（P2002 兜底 + 账号锁串行）。
// 发奖由结算任务在服务端写档（commitState），客户端没有任何领取入口。
// 不建 User 关联：账号注销后仍保留审计线索；查询只按 userId 过滤。
model RankReward {
  id        Int      @id @default(autoincrement())
  periodKey String
  boardKey  String
  userId    String
  rank      Int
  reward    String
  revision  Int      @default(0)
  grantedAt DateTime @default(now())

  @@unique([periodKey, boardKey, userId])
  @@index([userId, grantedAt])
}


// F14 Boss 双档奖励发放记录：唯一键防重复发放（P2002 兜底 + 账号锁串行）。
// 每场小包 grantKey = boss:run:<battleId>；每日首讨大包 = boss:first:<periodKey>:<bossId>:<userId>。
// 发奖由服务端在 Boss 结算时写档（commitState），客户端没有任何领取入口。
// 不建 User 关联：账号注销后仍保留审计线索；查询只按 userId 过滤。
model BossRewardGrant {
  id        Int      @id @default(autoincrement())
  userId    String
  bossId    String
  periodKey String
  // 档位：per_run（每场小包）/ first（每日首讨大包）
  tier      String
  grantKey  String   @unique
  battleId  String
  reward    String
  revision  Int      @default(0)
  grantedAt DateTime @default(now())

  @@index([userId, periodKey])
  @@index([bossId, periodKey])
}

// F16 共斗六房副本通关奖励发放记录（2026-11-09）。
// 唯一键 (roomId, userId) 保证「同一场副本重复结算不双花」；
// grantKey = coop:clear:<roomId>:<userId>，与 F02/F14 同一占位范式。
// 每日通关上限以本表按 (userId, periodKey) 计数为真值（重启不重置），
// 内存 quota 只记在途 hold。发奖由服务端在副本结算时写档（commitState），
// 客户端没有任何领取入口；伪上报房间状态 / 贡献 / 奖励一律 400。
// 不建 User 关联：账号注销后仍保留审计线索；查询只按 userId 过滤。
model CoopRewardGrant {
  id           Int      @id @default(autoincrement())
  roomId       String
  userId       String
  periodKey    String
  // 该成员在本场副本的累计有效伤害（最低贡献门槛判定依据，服务端真值）
  contribution Int      @default(0)
  grantKey     String   @unique
  reward       String
  revision     Int      @default(0)
  grantedAt    DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId, periodKey])
}

// F04 召唤师等级 / 徽章 / 成就（2026-11-10，规范 §31.5）。
// **按 userId 账号级**，不按 slot（F17 单档化铺路）；不写 SaveData、不动 SCHEMA_VERSION。
// 等级完全由「基础 5 + Σ徽章加成」只读派生，没有 PlayerProgress 宽表、无需老档回填。
// @@unique 保证重复发放 / 重复首通幂等（P2002 兜底），**不取应用层锁**：
// 调用链可能在战斗结算的账号锁内，重演 F14 同锁重入死锁（bug_log §36）。
// 不建 User 关联，与 BossRewardGrant / CoopRewardGrant 同风格；按 userId 过滤。
model BadgeGrant {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  source    String
  grantedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId, grantedAt])
}

model AchievementGrant {
  id             String   @id @default(cuid())
  userId         String
  achievementId  String
  source         String
  grantedAt      DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId, grantedAt])
}

// P5-1 W6（#181）：房间共享存储真值（owner key = roomId）。
// 整房态序列化进 `data`（RoomState JSON 文本），`revision` 提列为 CAS 基线，
// 与 W2 的 Save.revision 同范式；pvp / coop 嵌套态随房态一起落库，反序列化副本经显式
// load / modify / commit 写回（设计定稿 §3.6，修复「改字段靠同一引用隐式生效」的序列化三障碍）。
// 纯新增表，不改动任何既有模型，产品代码零改动先行验收。
model Room {
  roomId    String   @id
  mode      String
  status    String
  revision  Int      @default(1)
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([updatedAt])
}

// P5-1 W6（#181/#184）：房间 quota 每日已消耗次数真值。
// `held`（在途）走 Redis 租约（W6.4）；`committed`（最终消耗）走本表，
// 唯一键 (quotaKey, periodKey) 保证「每日上限」由 DB 事务内二次 count + 条件更新裁决，
// 重启不重置、不与 Redis 真值分叉（设计定稿 §3.3）。
model RoomQuotaDaily {
  id        Int      @id @default(autoincrement())
  quotaKey  String
  periodKey String
  committed Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([quotaKey, periodKey])
  @@index([quotaKey, periodKey])
}

// P5-1 W6（#182）：房间 quota 在途真值（原始 held/committed，按 quotaKey 一维）。
// 与 RoomQuotaDaily 分工：本表是「当前在途占用」活账，RoomQuotaDaily 是「每日已消耗」
// 累计账（W6.4 每日上限用）。CAS 行版本靠 room 表承载（quota 自身无 revision 列，
// 因为其写经 `withRoomLock(quotaKey)` 串行，且 held 只增不减、release 幂等）。
model RoomQuota {
  key       String @id
  held      Int    @default(0)
  committed Int    @default(0)
  updatedAt DateTime @updatedAt
}
