// MonsterPK 后端数据模型
// SQLite + Prisma。迁移到 Postgres 只需把 datasource.provider 改成 "postgresql" 并改 DATABASE_URL。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 账号表：用户名唯一，密码存 bcrypt 哈希；角色与封号状态用于服务端风控
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  // 角色：player=普通玩家 / admin=管理员（测试菜单可用，异常数值放行）
  // 授权来源还有 .env 的 ADMIN_USERNAMES 白名单，两者取并集；判定在 lib/account.ts
  role      String   @default("player")
  // 封号时间，非空即视为已封号；认证守卫会拒绝该账号的所有后续请求
  bannedAt  DateTime?
  // 封号中文原因（展示给客户端弹窗）
  banReason String?
  // P4-1a 登录代次（顶号）：每次注册/登录 +1 并写进 JWT 的 sv。
  // 认证守卫比对 sv，旧设备 token 立刻失效，避免「刷新页面又把新设备顶掉」的死循环。
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  saves     Save[]
  bans      BanRecord[]
}

// 封号审计表：每次封号留痕，便于排查误封与执行解封；不存完整存档，避免表膨胀
model BanRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 触发封号时操作的存档槽位（非存档类违规可为空）
  slot      Int?
  // 触发封号的校验码列表，JSON 文本
  codes     String
  // 中文原因
  reason    String
  // 存档摘要指标，JSON 文本（money/maxLevel/...），不含完整存档
  stats     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// 存档表：每个用户最多 3 个槽位（slot 1/2/3），data 为完整存档 JSON 文本
model Save {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot          Int
  data          String
  // 存档内部 schema 版本（取自 data 解析后的 version 字段），用于识别脏档/版本错配
  schemaVersion String   @default("unknown")
  // 最近一次写入的客户端标识（每设备唯一），用于冲突判断（多端并发编辑同一槽位时）
  clientId      String?
  // P1-2 服务端权威摘要（JSON 文本）：expected 资源摘要 + 挂机会话的服务端时钟 + revision。
  // 客户端整包 PUT 时用它做单调比对，自造的资源增量一律拒绝；裁决接口执行后同步更新。
  authority     String?
  updatedAt     DateTime @updatedAt

  @@unique([userId, slot])
}

// 意图幂等表（P1-2）：每个意图带一次性 nonce，服务端用唯一索引防重放（重复领挂机收益等）。
// 不建 User 关联，避免级联删除干扰；按 userId+slot 定期清理即可。
model IntentLog {
  id        Int      @id @default(autoincrement())
  userId    String
  slot      Int
  nonce     String
  // 意图类型：idle_start / idle_claim / idle_cancel / capture / battle_reward / shop_buy / ...
  type      String
  createdAt DateTime @default(now())

  @@unique([userId, slot, nonce])
  @@index([userId, slot, createdAt])
}

// Boss 伤害事件（P4-2c）：**append-only**，一行 = 一次有效讨伐的结算结果。
// - 伤害值只来自服务端战斗态（`BattleState.damageDealt`），客户端上报一律不用；
// - `battleId` 唯一索引保证「同一场战斗重复结算 / 重复上报不叠加」；
// - 每日次数真值 = 本表该用户当日该 Boss 的行数（内存只记在途 hold，重启不重置次数）；
// - 不建 User 关联：封号清理不删历史伤害记录，查询时再按 User 过滤封号/管理员。
model BossDamageEvent {
  id        String   @id @default(cuid())
  userId    String
  slot      Int
  bossId    String
  // 周期键：固定 UTC+8 自然日 YYYY-MM-DD；周期结算规则待台账 F01 细化
  periodKey String
  damage    Int
  // 结算结果：enemy_fainted / player_fainted（逃跑不写事件）
  result    String
  battleId  String   @unique
  createdAt DateTime @default(now())

  @@index([bossId, periodKey, damage])
  @@index([userId, bossId, periodKey])
}
